# FunscriptForge — local environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and stays on your machine.

# Enable Python plugin loading (paid SaaS tier only — disabled by default)
# Set to 1 to allow .py plugin files in the plugins/ directory
# FUNSCRIPT_PLUGINS_ENABLED=1

# --- Set automatically by launcher.py — do not set these manually ---
# FUNSCRIPT_FORGE_LOCAL=1
# FUNSCRIPT_FORGE_MEDIA_PORT=<port>
# FUNSCRIPT_FORGE_DATA_DIR=<path>
