[
  {
    "index": 1,
    "start": "00:00:03,000",
    "end": "00:00:06,000",
    "start_ms": 3000,
    "end_ms": 6000,
    "text": "In a quiet forest, a big buck bunny sleeps peacefully."
  },
  {
    "index": 2,
    "start": "00:00:08,500",
    "end": "00:00:12,000",
    "start_ms": 8500,
    "end_ms": 12000,
    "text": "Three small creatures watch from the shadows, plotting mischief."
  },
  {
    "index": 3,
    "start": "00:00:14,000",
    "end": "00:00:17,500",
    "start_ms": 14000,
    "end_ms": 17500,
    "text": "The bunny wakes, stretching lazily in the warm morning sun."
  },
  {
    "index": 4,
    "start": "00:00:20,000",
    "end": "00:00:24,000",
    "start_ms": 20000,
    "end_ms": 24000,
    "text": "Suddenly — a butterfly lands on his nose. He freezes."
  },
  {
    "index": 5,
    "start": "00:00:26,500",
    "end": "00:00:30,000",
    "start_ms": 26500,
    "end_ms": 30000,
    "text": "The creatures strike! They steal his mushrooms and run."
  },
  {
    "index": 6,
    "start": "00:00:32,000",
    "end": "00:00:36,500",
    "start_ms": 32000,
    "end_ms": 36500,
    "text": "The bunny's eyes narrow. Something shifts in his expression."
  },
  {
    "index": 7,
    "start": "00:00:38,000",
    "end": "00:00:42,000",
    "start_ms": 38000,
    "end_ms": 42000,
    "text": "He is no longer sleepy. He is focused. Angry."
  },
  {
    "index": 8,
    "start": "00:00:44,500",
    "end": "00:00:48,000",
    "start_ms": 44500,
    "end_ms": 48000,
    "text": "One by one, he hunts them down through the forest."
  },
  {
    "index": 9,
    "start": "00:00:50,000",
    "end": "00:00:54,500",
    "start_ms": 50000,
    "end_ms": 54500,
    "text": "The chase builds — faster, harder, more intense with each step."
  },
  {
    "index": 10,
    "start": "00:00:56,000",
    "end": "00:01:00,000",
    "start_ms": 56000,
    "end_ms": 60000,
    "text": "Justice is swift. The forest is quiet again."
  },
  {
    "index": 11,
    "start": "00:01:02,500",
    "end": "00:01:06,000",
    "start_ms": 62500,
    "end_ms": 66000,
    "text": "The bunny returns to his clearing, victorious and calm."
  },
  {
    "index": 12,
    "start": "00:01:08,000",
    "end": "00:01:12,000",
    "start_ms": 68000,
    "end_ms": 72000,
    "text": "He sits down. Picks up a mushroom. Eats it slowly."
  },
  {
    "index": 13,
    "start": "00:01:14,500",
    "end": "00:01:18,000",
    "start_ms": 74500,
    "end_ms": 78000,
    "text": "A butterfly lands on his nose again. He smiles."
  }
]